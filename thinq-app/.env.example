# Copy this file to .env and fill in the values. Never share or commit .env.

# Which AI service Thinq uses: "groq" (free tier, no card needed) or "anthropic" (Claude, paid, best quality).
AI_PROVIDER=groq

# --- Groq (free) - get a key at https://console.groq.com/keys ---
GROQ_API_KEY=
# Optional: a different Groq model (see https://console.groq.com/docs/models)
# GROQ_MODEL=openai/gpt-oss-120b
# Voice notes use Groq speech-to-text (needs GROQ_API_KEY even when AI_PROVIDER=anthropic):
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Images (optional, free) - Cloudflare Workers AI, FLUX.1 schnell ---
# dash.cloudflare.com -> AI -> Workers AI -> "Use REST API": copy the Account ID and create an API token.
# The free plan includes ~130 images a day for the whole server (10,000 neurons, resets midnight UTC).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# IMAGE_DAILY_LIMIT=10   # per person per day

# --- Voices for "Read aloud" (optional). Tried in order: ElevenLabs -> Cloudflare (free) -> the browser's voice ---
# ElevenLabs (best sound, paid per character): elevenlabs.io -> Developers -> API Keys -> create a key with
# "Text to Speech" access, and copy the value starting with sk_ (it's shown only once).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # any voice ID from ElevenLabs' Voice Library ("George" by default)
# ELEVENLABS_MODEL=eleven_flash_v2_5         # flash is fastest and cheapest; eleven_multilingual_v2 sounds richer
# The free voice (Cloudflare MeloTTS) turns on by itself when the Cloudflare image settings above are set.
# It shares the free daily allowance with images but uses very little of it (about 19 neurons per audio minute).
# SPEECH_FREE_VOICE=off                      # turn the free Cloudflare voice off
# SPEECH_PROVIDER=cloudflare                 # skip ElevenLabs and always use the free voice
# SPEECH_MAX_CHARS=2500                      # longest reply read aloud by the server (longer ones are cut)

# --- WhatsApp (optional) - Meta's official WhatsApp Cloud API. Setup steps in README.md ---
# WHATSAPP_TOKEN=            # access token (temporary 24h one for testing, or a System User token)
# WHATSAPP_PHONE_NUMBER_ID=  # "Phone number ID" from WhatsApp -> API Setup (not the phone number)
# WHATSAPP_APP_SECRET=       # App settings -> Basic -> App secret (used to check messages really come from Meta)
# WHATSAPP_VERIFY_TOKEN=     # any long random string; paste the same one into Meta's webhook settings
# WHATSAPP_NUMBER=15551234567   # the number people message, digits only (for "Open WhatsApp" links)

# --- Anthropic (Claude) - get a key at https://console.anthropic.com ---
ANTHROPIC_API_KEY=
# Optional: which Claude model, and how hard it thinks (low | medium | high)
# THINQ_MODEL=claude-opus-5-5
# THINQ_EFFORT=medium

# --- Google: used for "Log in with Google" and for connecting Gmail + Calendar (see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Who can sign in (invite list) ---
# Comma-separated emails and/or @domains, e.g. you@gmail.com,friend@gmail.com,@yourcompany.com - or * for anyone.
# Locally, leaving it empty lets anyone sign in. In production, empty means NOBODY can sign in.
ALLOWED_EMAILS=

# AI requests each person can make per day (0 = no limit)
# DAILY_REQUEST_LIMIT=60

# --- Hosting (set these on your server, not needed locally) ---
# DATABASE_URL=postgres://...       # leave unset locally: a built-in database is stored in ./data
# TOKEN_ENCRYPTION_KEY=...          # long random string; encrypts stored Google tokens. Never change it once set.
# PUBLIC_URL=https://thinq.ai       # your site's address, if you use your own domain
# PORT=3000
